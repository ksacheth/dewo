# Arkiv access key from the Arkiv hub (not a secret; restrict to our origins). Required for real writes/reads.
ARKIV_ACCESS_KEY=
# Optional RPC override (default: Rabdi RPC derived from the access key)
ARKIV_RPC=
# Comma-separated Verifier addresses; the only owners trusted for Verdicts (D5). Same value in M4, M5, web.
VERIFIER_ADDRESSES=
# File backing @dewo/board/mock, shared by every process (D6)
BOARD_MOCK_FILE=runs/board-mock.json
# Event feed root (default: <repo root>/runs)
RUNS_DIR=
# Funded wallet key, only for the real-Arkiv contract test and smoke script
TEST_PRIVATE_KEY=
