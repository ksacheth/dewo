# @dewo/agents configuration. Copy to .env and fill in. Never commit .env.
# Settings in decimal USDC (REQUESTER_MAX_BOUNTY, WORKER_COST_PER_DECISION, WORKER_TX_FEES) are converted to
# base units (6 decimals) once, at the config boundary; everything past it, and *_UNITS settings, are base units.

# --- Shared ---
# Folder the I8 event feed is written to: runs/<missionId>/events.<process>.ndjson, one file per process
# (process is "requester" or "worker-<policy name>").
RUNS_DIR=../runs
# The 3 Verifiers, in the same order everywhere (board D5/D7): URLs, EVM addresses, ECIES public keys.
VERIFIER_URLS=http://localhost:7101,http://localhost:7102,http://localhost:7103
VERIFIER_ADDRESSES=
VERIFIER_PUBKEYS=

# --- Hedera testnet (chain 296): MissionEscrow + USDC (HTS 0.0.429274) ---
HEDERA_RPC_URL=https://testnet.hashio.io/api
MISSION_ESCROW_ADDRESS=
# Each agent's Hedera account must be associated with USDC before it can receive payouts.

# --- 0G Galileo testnet (chain 16602): EpisodeRegistry, Compute, Storage ---
ZG_RPC_URL=https://evmrpc-testnet.0g.ai
ZG_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
EPISODE_REGISTRY_ADDRESS=

# --- Arkiv (Mission Board) ---
ARKIV_ACCESS_KEY=
# Shared file used by @dewo/board/mock until the real library is wired (board D6).
BOARD_MOCK_FILE=../runs/board-mock.json

# --- Simulator (I1) ---
# Space-separated command prefix for the sim CLI. Workers run the same pinned Docker image the Verifiers
# replay with (dewo-sim, linux/amd64), so frameHash and the PNG bytes sent to 0G are bit-identical to a
# Verifier Replay. The wrapper takes the same arguments as `sim`.
SIM_COMMAND=../sim/scripts/sim-docker
# Native `uv run --project ../sim sim` is for development only: its frame hashes and PNG bytes will not
# match a Verifier Replay, so Verdicts for such Episodes can fail.

# --- Requester agent ---
REQUESTER_PORT=7000
# The HTTP API binds to loopback by default; set 0.0.0.0 only behind something you trust.
REQUESTER_HOST=127.0.0.1
# The one browser origin allowed to call POST /missions (the web UI proxies through Vite, so same-origin anyway).
REQUESTER_ALLOWED_ORIGIN=http://localhost:5173
# When set, POST /missions needs "Authorization: Bearer <token>".
REQUESTER_API_TOKEN=
# Largest maxBounty a request may lock, in decimal USDC.
REQUESTER_MAX_BOUNTY=50
# EVM key used on Hedera for createMission / award / settle.
REQUESTER_PRIVATE_KEY=
# Hedera account + key that pays Verifiers through x402 and writes the HCS spending log.
REQUESTER_HEDERA_ACCOUNT_ID=
REQUESTER_HEDERA_PRIVATE_KEY=
# Spending caps: per Replay in USDC base units (100000 = 0.10 USDC), and Replays per Mission.
MAX_REPLAY_PRICE_UNITS=100000
MAX_PAID_REPLAYS=3
# x402 payment checks: only pay this network and asset, and, if set, only these payee Hedera accounts.
VERIFIER_PAYMENT_NETWORK=hedera:testnet
VERIFIER_PAYMENT_ASSET=0.0.429274
VERIFIER_PAYEES=
# Verifier HTTP timeout in milliseconds (a Replay runs MuJoCo).
VERIFIER_TIMEOUT_MS=180000
# Optional; leave empty to create a topic on first run.
HCS_TOPIC_ID=

# --- Worker agents (one process per Policy) ---
# The demo Policies ship with placeholder `model` ("TBD-...") and a zero `providerAddress`: fill in a real
# 0G model id and provider address (chosen during testnet setup) before starting a Worker, which refuses to
# start otherwise. The prompt must keep the {{frame}} and {{history}} placeholders.
WORKER_POLICY=policies/careful.json
# Signs stake() on Hedera and submitEpisode + 0G calls on Galileo.
WORKER_PRIVATE_KEY=
# Public key put in the Bid; the Seed Release is encrypted to it.
WORKER_PUBKEY=
# The Worker's own pricing strategy, in decimal USDC.
WORKER_COST_PER_DECISION=0.05
WORKER_EXPECTED_DECISIONS=15
WORKER_TX_FEES=0.05
WORKER_MARGIN=1.6
# 0G Compute cost of one Decision, in 0G ledger units.
WORKER_ZG_PER_DECISION=0.05
