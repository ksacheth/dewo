# Same values as board/.env (web reads web/.env first, then board/.env)
ARKIV_ACCESS_KEY=
VERIFIER_ADDRESSES=
# real | mock (default: real when ARKIV_ACCESS_KEY is set)
BOARD=
# Used only by the "mock requester" to write the Mission entity
TEST_PRIVATE_KEY=
# Event feed root (default <repo root>/runs)
RUNS_DIR=
# Requester API from M4 (I7). Unset: the Post Mission button uses the labelled mock requester.
VITE_REQUESTER_URL=
# Bearer token the dev server adds to /requester proxy calls (R13). Server-side only, never sent to the browser; leave unset if the Requester API needs no token.
REQUESTER_API_TOKEN=
# Wallets allowed to sign in (comma-separated EVM addresses). Empty: any wallet may sign in. Posting always needs the Requester role.
OPERATOR_ADDRESSES=
# Signs the operator session cookie. Unset: a random one per server start (sessions end on restart).
SESSION_SECRET=
# The Requester's stake window in seconds (REQUESTER_STAKE_SECONDS in agents/.env), for the Stake countdown. Unset: 30 (spec default).
STAKE_WINDOW_SECONDS=
# Command prefix for the sim CLI, used to draw the public Course from its Seed. Unset: ../sim/scripts/sim-docker. If it fails, the Result shows a placeholder.
SIM_COMMAND=
