# One instance per key. run-quorum.sh sets PORT 7101..7103 and VERIFIER_KEY per instance.
VERIFIER_KEY=0x
PORT=7101
# Arkiv (@dewo/board). VERIFIER_ADDRESSES is the same list in the Requester, Workers, web UI and all 3 Verifiers:
# only Verdicts written by these addresses count towards Reliability.
ARKIV_ACCESS_KEY=
VERIFIER_ADDRESSES=0x,0x,0x
# Contracts: set the address, or leave empty to read chain/deployments/{hedera-testnet,0g-galileo}.json
HEDERA_RPC_URL=https://testnet.hashio.io/api
MISSION_ESCROW_ADDRESS=
EPISODE_REGISTRY_ADDRESS=
# Hedera testnet account that receives x402 Replay payments
HEDERA_PAY_TO=0.0.0
HEDERA_NETWORK=hedera:testnet
X402_FACILITATOR_URL=https://api.testnet.blocky402.com
# 0G Galileo (chain 16602)
ZG_RPC_URL=https://evmrpc-testnet.0g.ai
ZG_STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai
RUNS_DIR=../runs
# Where chain/deployments/*.json live
CHAIN_DEPLOYMENTS_DIR=../chain/deployments
# How to run the sim. Replays must run in the pinned dewo-sim image (build it with `make image` in sim/; DEWO_SIM_VERSION picks the tag),
# so frame hashes match the Workers'. Inside the Verifier Docker image (built on that image) use SIM_CMD=sim.
# `uv run --project ../sim sim` is for development only: its hashes will not match a Worker's.
SIM_CMD=../sim/scripts/sim-docker
# Spike #6 only (copy to .env.spike, never commit): the payer that pays one Replay through x402
HEDERA_CLIENT_ACCOUNT_ID=0.0.0
HEDERA_CLIENT_PRIVATE_KEY=0x
# Optional: override the HTS token charged per Replay (default 0.0.429274, Circle testnet USDC, 6 decimals).
# It must equal the Requester's VERIFIER_PAYMENT_ASSET, or the Requester refuses to pay.
#X402_ASSET=0.0.429274
