# One instance per key. run-quorum.sh sets PORT 7101..7103 and VERIFIER_KEY per instance.
VERIFIER_KEY=0x
PORT=7101
# Arkiv (@dewo/board). VERIFIER_ADDRESSES is the same list in the Requester, Workers and web UI (the board's leaderboard reads it). Required here:
# /award and /replay refuse a Mission whose on-chain Verifiers are not these 3 (any order), and it must include this instance (ADR 0005).
ARKIV_ACCESS_KEY=
VERIFIER_ADDRESSES=0x,0x,0x
# Contracts: set the address, or leave empty to read chain/deployments/{hedera-testnet,0g-galileo}.json
HEDERA_RPC_URL=https://testnet.hashio.io/api
MISSION_ESCROW_ADDRESS=
EPISODE_REGISTRY_ADDRESS=
# Hedera testnet account that receives x402 Replay payments
HEDERA_PAY_TO=0.0.0
HEDERA_NETWORK=hedera:testnet
X402_FACILITATOR_URL=https://api.testnet.blocky402.com
# 0G RPCs split by purpose (ADR 0004).
# Galileo (chain 16602): the EpisodeRegistry read, the 0G Storage download, and the Flow contract that proves an upload happened
# (a root never submitted there is a Fail, not a 503). ZG_FLOW_ADDRESS defaults to the Galileo Flow contract.
ZG_RPC_URL=https://evmrpc-testnet.0g.ai
ZG_STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai
#ZG_FLOW_ADDRESS=0x22e03a6a89b950f1c82ec5e74f8eca321a105296
# Seconds the Galileo head must be past an Episode's submission before this Verifier replays it (default 120). A lagging
# load-balanced RPC node answers eth_getLogs with an empty list, which would read as "not uploaded" and sign a wrong Fail; the
# margin avoids that. Every Verifier of a Quorum must use the same value. 0 answers at once and accepts that risk.
ZG_HEAD_MARGIN_SECONDS=
# 0G mainnet (chain 16661): processResponse(providerAddress, chatID) for each Decision, which Workers get answered
# through the 0G Router. Read-only on a throwaway wallet: no funds, no account, VERIFIER_KEY is not used there.
# Startup fails if this URL is not chain 16661.
ZG_MAINNET_RPC_URL=https://evmrpc.0g.ai
RUNS_DIR=../runs
# Where chain/deployments/*.json live
CHAIN_DEPLOYMENTS_DIR=../chain/deployments
# How to run the sim. Replays must run in the pinned dewo-sim image (build it with `make image` in sim/; DEWO_SIM_VERSION picks the tag),
# so frame hashes match the Workers'. Inside the Verifier Docker image (built on that image) use SIM_CMD=sim.
# `uv run --project ../sim sim` is for development only: its hashes will not match a Worker's.
# The Verifier refuses to start unless `$SIM_CMD --version` answers 0.3.0 (SIM_VERSION in src/adapters/sim-cli.ts).
SIM_CMD=../sim/scripts/sim-docker
# Spike #6 only (copy to .env.spike, never commit): the payer that pays one Replay through x402
HEDERA_CLIENT_ACCOUNT_ID=0.0.0
HEDERA_CLIENT_PRIVATE_KEY=0x
# Optional: override the HTS token charged per Replay (default 0.0.429274, Circle testnet USDC, 6 decimals).
# It must equal the Requester's VERIFIER_PAYMENT_ASSET, or the Requester refuses to pay.
#X402_ASSET=0.0.429274
